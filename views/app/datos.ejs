<%#
  Datos entre dos fechas, cortados como se quiera — ref. 8b del diseño, que
  había quedado para "una segunda etapa".

  Reemplaza el trabajo de bajar el Excel y filtrar afuera. Todo por GET: el
  botón "atrás" del teléfono vuelve al corte anterior y la dirección se puede
  compartir tal cual.
%>
<%
  // Lo ya elegido, listo para pegar en cualquier enlace. Todo viaja en la
  // dirección: no hay estado guardado, el "atrás" del teléfono deshace un paso
  // y el link se puede compartir tal cual.
  var filtrosEnUrl = filtros.map(function (f) {
    return '&f=' + encodeURIComponent(f.crudo);
  }).join('');
  var cortesEnUrl = cortes.map(function (c) { return '&corte=' + c; }).join('');
  // Los cortes SIN uno: es lo que hace la ✕ de cada corte elegido.
  function cortesSalvo(quitar) {
    return cortes.filter(function (c) { return c !== quitar; })
      .map(function (c) { return '&corte=' + c; }).join('');
  }
  var fechaEnUrl = '&periodo=' + periodo + '&desde=' + desde + '&hasta=' + hasta;
%>
<div class="pantalla">

  <div class="enc">
    <div class="enc-col">
      <a href="/app/general" class="volver"><span class="flecha">‹</span><span class="texto">Resumen</span></a>
      <span class="etiqueta"><%= alcance %></span>
      <span class="t-pantalla">Datos</span>
    </div>
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px">
      <span class="conexion en-linea" data-conexion>EN LÍNEA</span>
      <%- include('menu') %>
    </div>
  </div>

  <div class="cuerpo" style="gap:11px">

    <%# 1. Qué período. Los cuatro de un toque, y el desde–hasta abajo. %>
    <div class="chips">
      <%# Sin "Campaña": para mirar toda la campaña está el desde–hasta de abajo.
          Como chip invitaba a traerse miles de tickets de todas las balanzas de
          un toque, casi siempre sin querer. %>
      <% [['hoy','Hoy'],['semana','7 días'],['mes','30 días']].forEach(function (p) { %>
        <a class="chip-elegible<%= periodo === p[0] ? ' elegido' : '' %>"
           href="/app/datos?periodo=<%= p[0] %><%= cortesEnUrl %><%= filtrosEnUrl %>"><%= p[1] %></a>
      <% }); %>
    </div>

    <form class="tarjeta tarjeta-chica" method="GET" action="/app/datos" style="gap:9px">
      <% cortes.forEach(function (c) { %><input type="hidden" name="corte" value="<%= c %>"><% }); %>
      <% filtros.forEach(function (f) { %><input type="hidden" name="f" value="<%= f.crudo %>"><% }); %>
      <span class="etiqueta">O un rango a mano</span>
      <div class="fila" style="gap:8px">
        <input type="date" name="desde" value="<%= desde %>" max="<%= hoy %>" style="flex:1">
        <input type="date" name="hasta" value="<%= hasta %>" max="<%= hoy %>" style="flex:1">
        <button type="submit" class="btn btn-borde-suave" style="width:auto; padding:0 16px">Ir</button>
      </div>
    </form>

    <%# Los filtros encadenados, a la vista y desarmables de a uno. Sin esto,
        el número grande de abajo es un total del que no se sabe de qué es. %>
    <% if (filtros.length) { %>
      <div class="campo">
        <span class="etiqueta">Filtrando por</span>
        <div class="chips" style="margin-top:6px">
          <% filtros.forEach(function (f, i) { %>
            <%# El enlace rearma la lista SIN este filtro: sacar uno del medio
                no tiene que tirar abajo los que vienen después. %>
            <a class="chip-elegible elegido"
               href="/app/datos?<%= fechaEnUrl.slice(1) %><%= cortesEnUrl %><%
                 filtros.forEach(function (o, j) { if (j !== i) { %>&f=<%= encodeURIComponent(o.crudo) %><% } });
               %>"><%= f.etiqueta %>: <%= f.valor %> &nbsp;✕</a>
          <% }); %>
        </div>
      </div>
    <% } %>

    <%# 2. El número grande, con lo que hay que saber para leerlo bien. %>
    <div class="tarjeta" style="gap:6px">
      <span class="etiqueta">Neto de <%= desdeBonito %><%= desde === hasta ? '' : ' a ' + hastaBonito %></span>
      <span class="dato-xg"><%= kg(total) %></span>
      <span class="txt-aux">
        kg · <%= (total / 1000).toLocaleString('es-AR', { maximumFractionDigits: 1 }) %> toneladas ·
        <%= camiones %> <%= camiones === 1 ? 'camión' : 'camiones' %>
      </span>
      <%# Que nadie compare este número con "En curso" y crea que falta plata. %>
      <span class="txt-aux">Cuenta solo los camiones con la regulada cerrada. Los anulados quedan afuera.</span>
    </div>

    <%# 3. Cómo se corta. Cambiar de corte no cambia el período. %>
    <%# Los cortes elegidos, arriba y desarmables de a uno. Se suman: eligiendo
        Silobolsa, después Campo y después Socio, cada renglón de abajo es la
        combinación de los tres. %>
    <div class="campo">
      <span class="etiqueta">Mostrando kg por</span>
      <div class="chips" style="margin-top:6px">
        <% cortes.forEach(function (c, i) { %>
          <% if (cortes.length > 1) { %>
            <a class="chip-elegible elegido"
               href="/app/datos?<%= fechaEnUrl.slice(1) %><%= cortesSalvo(c) %><%= filtrosEnUrl %>"><%= cortesEtiquetas[i] %> &nbsp;✕</a>
          <% } else { %>
            <%# El último no se saca: sin ningún corte no hay nada que mostrar. %>
            <span class="chip-elegible elegido"><%= cortesEtiquetas[i] %></span>
          <% } %>
        <% }); %>
      </div>
    </div>

    <% if (puedeSumarCorte) { %>
      <div class="campo">
        <span class="etiqueta">Sumar otro corte</span>
        <div class="chips" style="margin-top:6px">
          <% disponibles.forEach(function (c) { %>
            <% if (!c.elegido) { %>
              <a class="chip-elegible"
                 href="/app/datos?<%= fechaEnUrl.slice(1) %><%= cortesEnUrl %>&corte=<%= c.clave %><%= filtrosEnUrl %>">＋ <%= c.etiqueta %></a>
            <% } %>
          <% }); %>
        </div>
      </div>
    <% } %>

    <% if (!filas.length) { %>
      <div class="tarjeta" style="gap:6px">
        <span class="cuerpo-fuerte">No hay reguladas cerradas en esas fechas</span>
        <span class="txt">Probá con un período más largo, o fijate en el resumen del día si hay camiones en curso.</span>
      </div>
    <% } else { %>
      <% if (!puedeFiltrarMas) { %>
        <span class="txt-aux">Llegaste al máximo de filtros encadenados. Sacá uno de arriba para seguir.</span>
      <% } %>
      <div class="tarjeta" style="gap:13px">
        <div class="fila-base">
          <span class="cuerpo-fuerte">Por <%= cortesEtiquetas.join(' · ').toLowerCase() %></span>
          <span class="mono-chico" style="letter-spacing:.06em"><%= filas.length %></span>
        </div>

        <div style="display:flex; flex-direction:column; gap:12px">
          <% filas.forEach(function (f, i) { %>
            <% if (i > 0) { %><div class="divisor"></div><% } %>
            <%# Tocar el renglón lo agrega como filtro: así se encadena
                fecha → silobolsa → socio → grano, sin volver atrás. %>
            <% var urlFila = '/app/datos?' + fechaEnUrl.slice(1) + cortesEnUrl + filtrosEnUrl +
                 f.filtros.map(function (x) { return '&f=' + encodeURIComponent(x); }).join(''); %>
            <% if (puedeFiltrarMas) { %><a href="<%= urlFila %>" style="text-decoration:none; color:inherit"><% } %>
            <div style="display:flex; flex-direction:column; gap:6px">
              <div class="fila-base">
                <span class="cuerpo-fuerte" style="font-size:15px">
                  <%= f.nombre %><% if (puedeFiltrarMas) { %><span class="ir-filtro">›</span><% } %>
                </span>
                <span class="mono" style="font:600 16px/1 var(--mono)"><%= kg(f.neto) %></span>
              </div>
              <%# La barra hace comparable de un vistazo lo que los números
                  sueltos no: cuál pesa y cuál es marginal. %>
              <div class="fila" style="gap:9px">
                <div class="proporcion" style="flex:1"><span style="width:<%= f.porcentaje %>%"></span></div>
                <span class="txt-aux" style="min-width:2.2em; text-align:right"><%= f.porcentaje %>%</span>
              </div>
            </div>
            <% if (puedeFiltrarMas) { %></a><% } %>
          <% }); %>
        </div>
      </div>

      <% if (reparteLotes) { %>
        <span class="txt-aux">
          Un viaje con más de un lote reparte su neto en partes iguales, igual que
          el resumen del día. Por eso la suma de los camiones puede dar más que el
          total de arriba.
        </span>
      <% } %>
    <% } %>

    <div class="espaciador"></div>
  </div>
</div>

<script>
(function () {
  'use strict';
  // Al volver acá se vuelve a pedir: estos números cambian con cada regulada
  // que se cierra y no hay nada escrito que se pueda perder.
  App.refrescarAlVolver();
})();
</script>
