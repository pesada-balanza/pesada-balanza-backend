<%#
  Corregir los datos de un ticket. SOLO GENERAL llega acá.

  El balancero no corrige: cuando encuentra un error pide la corrección y GENERAL
  la aplica. Los campos son los mismos que tenía el "Modificar" de la web.

  Los brutos NO están: son lo que marcó la balanza y es la única prueba del
  pesaje. Lo que se corrige es la tara, y con ella se recalculan los netos.
%>
<div class="pantalla">

  <div class="enc">
    <div class="enc-col">
      <a href="<%= volver %>" class="volver"><span class="flecha">‹</span><span class="texto">Ticket <%= r.nro %></span></a>
      <span class="t-pantalla">Corregir los datos</span>
    </div>
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px">
      <span class="conexion en-linea" data-conexion>EN LÍNEA</span>
      <%- include('menu') %>
    </div>
  </div>

  <div class="cuerpo">

    <% if (pedido) { %>
      <div class="aviso apilado">
        <span class="aviso-titulo">Corrección pedida</span>
        <span class="aviso-detalle">“<%= pedido.motivo %>”<%= pedido.pedidoPor ? ' · ' + pedido.pedidoPor : '' %></span>
      </div>
    <% } %>

    <%# Lo que no se toca, a la vista para no corregir a ciegas. %>
    <div class="tarjeta" style="gap:9px">
      <div class="fila-base">
        <span class="mono" style="font:600 17px/1 var(--mono)"><%= r.patentes %></span>
        <span class="mono-chico">#<%= r.nro %> · <%= r.balanza %></span>
      </div>
      <span class="txt"><%= [r.campo, r.grano, r.loteTexto].filter(Boolean).join(' · ') %></span>
      <div class="divisor"></div>
      <div class="fila-base">
        <span class="txt-chico">Bruto estimado</span>
        <span class="mono"><%= kg(r.brutoEstimado) %> kg <span class="chip-fijo">🔒 fijo</span></span>
      </div>
      <% if (r.bruto) { %>
        <div class="fila-base">
          <span class="txt-chico">Bruto regulado</span>
          <span class="mono"><%= kg(r.bruto) %> kg <span class="chip-fijo">🔒 fijo</span></span>
        </div>
      <% } %>
      <span class="txt-aux">
        Los brutos no se corrigen: son lo que marcó la balanza.
        <% if (r.modificaciones) { %>Este ticket ya se corrigió <%= r.modificaciones %> vez/veces.<% } %>
      </span>
    </div>

    <form id="form-corregir">

      <div class="campo">
        <label class="etiqueta" for="patentes">Patentes</label>
        <input type="text" id="patentes" name="patentes" class="mono" maxlength="60"
               autocomplete="off" autocapitalize="characters" spellcheck="false"
               value="<%= r.patentes %>">
      </div>

      <div class="campo" style="margin-top:11px">
        <label class="etiqueta" for="chofer">Chofer</label>
        <input type="text" id="chofer" name="chofer" maxlength="60" autocomplete="off"
               value="<%= r.chofer %>">
      </div>

      <%# Antes de la TARA FINAL lo que hay es la TARA ESTIMADA del ticket de
          camiones, que es opcional: se deja vacía si no se sabe. Mostrar un 0
          hacía pensar que el camión pesa cero, y exigirla trababa la
          corrección de cualquier otro dato. %>
      <div class="campo" style="margin-top:11px">
        <label class="etiqueta" for="tara">
          <%= r.fechaTaraFinal ? 'Tara (kg)' : 'Tara estimada (kg) · opcional' %>
        </label>
        <input type="tel" id="tara" name="tara" class="mono" inputmode="numeric"
               autocomplete="off"
               value="<%= r.fechaTaraFinal || r.tara ? r.tara : '' %>"
               placeholder="<%= r.fechaTaraFinal ? '' : 'sin tara todavía' %>">
        <span class="txt-aux" id="calculo">&nbsp;</span>
      </div>

      <%# Para quién se cargó. Es lo que agrupa los totales por socio, así que
          un error acá no lo arregla una observación: o se corrige, o el ticket
          queda mal contado. %>
      <div class="campo" style="margin-top:11px">
        <span class="etiqueta">Carga para</span>
        <div class="opciones" data-opciones="cargaPara">
          <button type="button" class="opcion<%= r.cargaPara !== 'SOCIO' ? ' elegida' : '' %>" data-valor="AMH">AMH</button>
          <button type="button" class="opcion<%= r.cargaPara === 'SOCIO' ? ' elegida' : '' %>" data-valor="SOCIO">Socio</button>
        </div>
        <input type="hidden" name="cargaPara" value="<%= r.cargaPara === 'SOCIO' ? 'SOCIO' : 'AMH' %>">
      </div>

      <div class="campo<%= r.cargaPara === 'SOCIO' ? '' : ' oculto' %>" id="campo-socio" style="margin-top:11px">
        <label class="etiqueta" for="socio">Nombre del socio</label>
        <% if (socios.length) { %>
          <select id="socio" name="socio">
            <option value="">Elegí el socio…</option>
            <%# El socio viejo puede no estar en la lista (se tipeaba a mano).
                Se agrega como opción para no perderlo sin querer al corregir
                otra cosa, pero marcado, para que se note que hay que cambiarlo. %>
            <% var enLista = socios.some(function (x) { return x === r.socio; }); %>
            <% if (r.socio && !enLista) { %>
              <option value="<%= r.socio %>" selected><%= r.socio %> (fuera de la lista)</option>
            <% } %>
            <% socios.forEach(function (x) { %>
              <option value="<%= x %>"<%= r.socio === x ? ' selected' : '' %>><%= x %></option>
            <% }); %>
          </select>
        <% } else { %>
          <input type="text" id="socio" name="socio" autocapitalize="words" maxlength="60" value="<%= r.socio %>">
        <% } %>
      </div>

      <div class="campo" style="margin-top:11px">
        <span class="etiqueta">Cargó de</span>
        <div class="opciones" data-opciones="cargoDe">
          <button type="button" class="opcion<%= r.cargoDe === 'SILOBOLSA' ? ' elegida' : '' %>" data-valor="SILOBOLSA">Silobolsa</button>
          <button type="button" class="opcion<%= r.cargoDe === 'CONTRATISTA' ? ' elegida' : '' %>" data-valor="CONTRATISTA">Contratista</button>
        </div>
        <input type="hidden" name="cargoDe" value="<%= r.cargoDe %>">
      </div>

      <div class="campo<%= r.cargoDe === 'SILOBOLSA' ? '' : ' oculto' %>" id="campo-silobolsa" style="margin-top:11px">
        <label class="etiqueta" for="silobolsa">Número de silobolsa</label>
        <input type="text" id="silobolsa" name="silobolsa" maxlength="40" autocomplete="off"
               value="<%= r.silobolsa %>">
      </div>

      <%# Contratistas y tractores son VARIOS, igual que en la regulada. Antes
          había un desplegable de cada uno: corregir cualquier dato de un ticket
          cargado con dos contratistas lo dejaba con uno solo, sin avisar.

          La lista es la de la planilla MÁS los que el ticket ya tenía: un
          contratista que salió de la planilla de este año no se puede perder
          por abrir esta pantalla. %>
      <div class="campo<%= r.cargoDe === 'CONTRATISTA' ? '' : ' oculto' %>" id="campo-contratista" style="margin-top:11px">
        <span class="etiqueta">Contratista <span style="text-transform:none; letter-spacing:0">(uno o más)</span></span>
        <div class="lista-casillas" id="lista-contratistas">
          <% var listaContr = contratistas.slice();
             contratistasElegidos.forEach(function (c) { if (listaContr.indexOf(c) === -1) listaContr.push(c); });
             listaContr.forEach(function (c) { %>
            <label class="casilla"><input type="checkbox" name="contratista" value="<%= c %>"
              data-contratista="<%= c %>"<%= contratistasElegidos.indexOf(c) !== -1 ? ' checked' : '' %>><span><%= c %></span></label>
          <% }); %>
        </div>
      </div>

      <div class="campo<%= r.cargoDe === 'CONTRATISTA' ? '' : ' oculto' %>" id="campo-tractor" style="margin-top:11px">
        <span class="etiqueta">Tractor <span style="text-transform:none; letter-spacing:0">(uno o más)</span></span>
        <div class="lista-casillas" id="lista-tractores">
          <div class="lista-vacia">Elegí primero el contratista.</div>
        </div>
      </div>

      <%# El mismo reparto que en la regulada: el último es el resto. Acá además
          se mueve solo al corregir la tara, que es justo lo que antes dejaba el
          ticket descuadrado. %>
      <div class="campo oculto" id="campo-kg-tract" style="margin-top:11px">
        <span class="etiqueta">Kg de cada tractor</span>
        <div class="caja-silo" id="filas-tract"></div>
        <span class="txt-aux" id="aviso-tract">&nbsp;</span>
      </div>

      <div class="campo" style="margin-top:11px">
        <label class="etiqueta" for="comentarios">Observaciones</label>
        <textarea id="comentarios" name="comentarios" rows="3" maxlength="500"><%= r.comentarios %></textarea>
      </div>

      <div class="campo-error" style="min-height:18px" id="error"></div>

      <button type="submit" class="btn btn-grande" id="guardar" style="margin-top:4px">Guardar la corrección</button>
      <a class="btn btn-texto" href="<%= volver %>">Cancelar</a>
    </form>

    <div class="espaciador"></div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var form = document.getElementById('form-corregir');
  var error = document.getElementById('error');
  var btn = document.getElementById('guardar');
  var inputTara = document.getElementById('tara');
  var calculo = document.getElementById('calculo');
  var ocultoCargo = form.elements['cargoDe'];
  var ocultoCargaPara = form.elements['cargaPara'];
  var campoSocio = document.getElementById('campo-socio');
  var inputSocio = document.getElementById('socio');
  var campoSilo = document.getElementById('campo-silobolsa');
  var campoContr = document.getElementById('campo-contratista');
  var campoTractor = document.getElementById('campo-tractor');
  var listaContr = document.getElementById('lista-contratistas');
  var listaTractores = document.getElementById('lista-tractores');
  var campoKgTract = document.getElementById('campo-kg-tract');
  var filasTract = document.getElementById('filas-tract');
  var avisoTract = document.getElementById('aviso-tract');

  var brutoEstimado = <%= Number(r.brutoEstimado) || 0 %>;
  var bruto = <%= r.bruto ? Number(r.bruto) : 0 %>;
  // Con la TARA FINAL cargada la tara es un peso de la balanza y no puede
  // quedar vacía. Antes es una estimación del ticket de camiones: opcional.
  var taraEsReal = <%= r.fechaTaraFinal ? 'true' : 'false' %>;
  var tractoresPor = <%- JSON.stringify(tractoresPorContratista) %>;
  var TRACTORES_DEL_TICKET = <%- JSON.stringify(tractoresElegidos) %>;
  var REPARTO_GUARDADO = <%- JSON.stringify(repartoTractores) %>;
  var TOPE_TRACTORES = <%= maximoTractores %>;

  /* ── Los netos, mientras se escribe la tara ───────────────────────────── */
  function mostrarCalculo() {
    var t = Number((inputTara.value || '').replace(/\D/g, ''));
    if (!t) { calculo.innerHTML = '&nbsp;'; return; }
    var partes = [];
    if (brutoEstimado) partes.push('neto estimado ' + App.miles(brutoEstimado - t) + ' kg');
    if (bruto) partes.push('neto ' + App.miles(bruto - t) + ' kg');
    calculo.innerHTML = partes.length ? App.esc(partes.join(' · ')) : '&nbsp;';
  }
  inputTara.addEventListener('input', function () {
    var limpio = (this.value || '').replace(/\D/g, '').slice(0, 7);
    if (limpio !== this.value) this.value = limpio;
    mostrarCalculo();
    // Cambiar la tara cambia el neto, y el reparto tiene que seguirlo.
    refrescarRestoTract();
  });
  mostrarCalculo();

  /* ── Contratistas → tractores → kg ────────────────────────────────────────
   * Misma mecánica que la regulada. La diferencia es que acá el neto se mueve
   * mientras se corrige la tara, así que el resto se recalcula con cada tecla:
   * es exactamente el descuadre que antes quedaba guardado sin que nadie lo
   * viera.
   * ─────────────────────────────────────────────────────────────────────── */
  var marcados = {};       // tractor → tildado (sobrevive al redibujo)
  var kgTract = {};        // tractor → kg tipeados
  var antesTract = [];
  var contrDeTractor = {};
  /* El orden importa: el último es el resto. Se arranca con el que quedó
     guardado, para que el ticket corregido se lea igual que el original. */
  var ordenTract = (REPARTO_GUARDADO.length
    ? REPARTO_GUARDADO.map(function (x) { return x.tractor; })
    : TRACTORES_DEL_TICKET).slice();

  for (var i0 = 0; i0 < TRACTORES_DEL_TICKET.length; i0++) marcados[TRACTORES_DEL_TICKET[i0]] = true;
  for (var i1 = 0; i1 < REPARTO_GUARDADO.length; i1++) {
    var g = REPARTO_GUARDADO[i1];
    if (g.contratista) contrDeTractor[g.tractor] = g.contratista;
    // El último no se copia: es el resto y se vuelve a calcular contra el neto.
    if (i1 < REPARTO_GUARDADO.length - 1) kgTract[g.tractor] = String(g.kg);
  }

  function contratistasTildados() {
    var l = [], c = listaContr.querySelectorAll('[data-contratista]');
    for (var i = 0; i < c.length; i++) if (c[i].checked) l.push(c[i].value);
    return l;
  }

  function contratistaDeTractor(t) {
    for (var n in tractoresPor) {
      if (tractoresPor[n].indexOf(t) !== -1) return n;
    }
    return contrDeTractor[t] || '';
  }

  /** Los tractores que se pueden elegir, según los contratistas tildados. */
  function tractoresDisponibles() {
    var contr = contratistasTildados();
    var out = [];
    for (var i = 0; i < contr.length; i++) {
      var lista = tractoresPor[contr[i]];
      if (!lista) {
        /* Contratista que ya no está en la planilla de este año: se ofrecen los
           tractores que el ticket traía de él, para no perderlos al corregir
           cualquier otra cosa. */
        lista = TRACTORES_DEL_TICKET.filter(function (t) {
          return (contrDeTractor[t] || '') === contr[i];
        });
        if (!lista.length) lista = TRACTORES_DEL_TICKET;
      }
      for (var j = 0; j < lista.length; j++) {
        if (out.indexOf(lista[j]) === -1) out.push(lista[j]);
      }
    }
    return out;
  }

  function pintarTractores() {
    var tractores = tractoresDisponibles();
    if (!tractores.length) {
      listaTractores.innerHTML = '<div class="lista-vacia">Elegí primero el contratista.</div>';
      antesTract = [];
      dibujarTract();
      return;
    }
    var h = '';
    for (var i = 0; i < tractores.length; i++) {
      h += '<label class="casilla"><input type="checkbox" name="tractor" value="' +
        App.esc(tractores[i]) + '" data-tractor="' + App.esc(tractores[i]) + '"' +
        (marcados[tractores[i]] ? ' checked' : '') + '><span class="mono">' +
        App.esc(tractores[i]) + '</span></label>';
    }
    listaTractores.innerHTML = h;
    antesTract = elegidosTract();
    dibujarTract();
  }

  /* En el orden en que se tildaron (o en el que quedó guardado), no en el de
     la lista: el último es el resto y no tiene que saltar de renglón. */
  function elegidosTract() {
    var tildados = {};
    var c = listaTractores.querySelectorAll('[data-tractor]');
    for (var i = 0; i < c.length; i++) if (c[i].checked) tildados[c[i].value] = true;
    var l = [];
    for (var j = 0; j < ordenTract.length; j++) {
      if (tildados[ordenTract[j]]) { l.push(ordenTract[j]); delete tildados[ordenTract[j]]; }
    }
    for (var k = 0; k < c.length; k++) if (tildados[c[k].value]) l.push(c[k].value);
    return l;
  }

  function netoActual() {
    if (!bruto) return 0;
    var t = Number((inputTara.value || '').replace(/\D/g, '')) || 0;
    var n = bruto - t;
    return n > 0 ? n : 0;
  }

  function repartidoTract(lista) {
    var s = 0;
    for (var i = 0; i < lista.length - 1; i++) s += Number(kgTract[lista[i]]) || 0;
    return s;
  }

  function restoTract(lista) { return netoActual() - repartidoTract(lista); }

  function avisarTract(lista) {
    var neto = netoActual();
    var resto = restoTract(lista);
    var falta = false;
    for (var i = 0; i < lista.length - 1; i++) {
      if (!(Number(kgTract[lista[i]]) > 0)) falta = true;
    }
    if (lista.length > TOPE_TRACTORES) {
      avisoTract.innerHTML = '<span class="campo-error">Son demasiados tractores para un viaje ' +
        '(máximo ' + TOPE_TRACTORES + ').</span>';
    } else if (!neto) {
      avisoTract.innerHTML = 'Sin regulada todavía no hay neto para repartir.';
    } else if (resto < 0) {
      avisoTract.innerHTML = '<span class="campo-error">Los kg puestos pasan el neto de ' +
        App.miles(neto) + '. Bajá alguno para poder guardar.</span>';
    } else if (falta) {
      avisoTract.innerHTML = '<span class="campo-error">Completá los kg de arriba</span>';
    } else if (lista.length === 1) {
      avisoTract.innerHTML = 'Se lleva todo el neto: ' + App.miles(neto) + ' kg.';
    } else {
      avisoTract.innerHTML = 'El último es el resto: ' + App.miles(neto) + ' menos lo de arriba.';
    }
  }

  function refrescarRestoTract() {
    var lista = elegidosTract();
    if (!lista.length) return;
    var u = filasTract.querySelector('.kg-resto');
    if (u) u.value = netoActual() ? App.miles(restoTract(lista)) : '';
    avisarTract(lista);
  }

  function dibujarTract() {
    var lista = elegidosTract();
    var hay = ocultoCargo.value === 'CONTRATISTA' && lista.length && bruto;
    campoKgTract.className = hay ? 'campo' : 'campo oculto';
    if (!hay) { filasTract.innerHTML = ''; return; }
    var h = '';
    for (var i = 0; i < lista.length; i++) {
      var ultimo = i === lista.length - 1;
      h += '<div class="fila-silo">' +
        '<span class="marca">•</span>' +
        '<span class="nombre-origen">' + App.esc(lista[i]) +
          '<span class="chico">' + App.esc(contratistaDeTractor(lista[i])) + '</span></span>' +
        '<span class="der">' +
          '<input class="kg-silo' + (ultimo ? ' kg-resto' : '') + '" inputmode="numeric" ' +
            'maxlength="5" data-tract="' + App.esc(lista[i]) + '"' + (ultimo ? ' readonly' : '') +
            ' value="' + (ultimo ? '' : App.esc(kgTract[lista[i]] || '')) + '">' +
          '<span class="unidad">kg</span>' +
        '</span></div>';
    }
    filasTract.innerHTML = h;
    refrescarRestoTract();
  }

  function congelarResto(antes) {
    if (!antes.length) return;
    var u = antes[antes.length - 1];
    if (!(Number(kgTract[u]) > 0)) kgTract[u] = String(Math.max(0, restoTract(antes)));
  }

  listaContr.addEventListener('change', pintarTractores);

  listaTractores.addEventListener('change', function (ev) {
    if (!ev.target.getAttribute || !ev.target.getAttribute('data-tractor')) return;
    var t = ev.target.value;
    marcados[t] = ev.target.checked;
    var pos = ordenTract.indexOf(t);
    if (ev.target.checked) { if (pos === -1) ordenTract.push(t); }
    else if (pos !== -1) ordenTract.splice(pos, 1);
    var ahora = elegidosTract();
    if (ahora.length > antesTract.length) congelarResto(antesTract);
    antesTract = ahora;
    dibujarTract();
  });

  filasTract.addEventListener('input', function (ev) {
    var el = ev.target;
    var t = el.getAttribute && el.getAttribute('data-tract');
    if (!t) return;
    el.value = (el.value || '').replace(/\D/g, '').slice(0, 5);
    kgTract[t] = el.value;
    refrescarRestoTract();
  });

  function repartoTractParaGuardar() {
    var lista = elegidosTract();
    if (lista.length > TOPE_TRACTORES) {
      return { error: 'Son demasiados tractores para un viaje (máximo ' + TOPE_TRACTORES + ').' };
    }
    var resto = restoTract(lista);
    if (resto < 0) return { error: 'Los kg de los tractores pasan el neto del viaje. Bajá alguno.' };
    var salida = [];
    for (var i = 0; i < lista.length; i++) {
      var kgT = i === lista.length - 1 ? resto : (Number(kgTract[lista[i]]) || 0);
      if (kgT <= 0) {
        return { error: 'El tractor ' + lista[i] + ' quedó en 0 kg. Completá los kg o destildalo.' };
      }
      salida.push({ tractor: lista[i], contratista: contratistaDeTractor(lista[i]), kg: kgT });
    }
    return { lista: salida };
  }

  /* ── AMH o Socio ──────────────────────────────────────────────────────── */
  function acomodarCargaPara() {
    var esSocio = ocultoCargaPara.value === 'SOCIO';
    campoSocio.className = 'campo' + (esSocio ? '' : ' oculto');
  }

  function acomodarCargo() {
    var v = ocultoCargo.value;
    campoSilo.className = 'campo' + (v === 'SILOBOLSA' ? '' : ' oculto');
    campoContr.className = 'campo' + (v === 'CONTRATISTA' ? '' : ' oculto');
    campoTractor.className = 'campo' + (v === 'CONTRATISTA' ? '' : ' oculto');
    dibujarTract();
  }

  // El manejo de los botones de opción ya está en app.js: se usa ese.
  App.conectarOpciones(form);
  ocultoCargo.addEventListener('cambio-opcion', acomodarCargo);
  ocultoCargaPara.addEventListener('cambio-opcion', acomodarCargaPara);
  acomodarCargaPara();
  pintarTractores();
  acomodarCargo();

  /* ── Guardar ──────────────────────────────────────────────────────────── */
  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    error.innerHTML = '';

    var datos = {
      patentes: document.getElementById('patentes').value,
      chofer: document.getElementById('chofer').value,
      tara: inputTara.value,
      cargaPara: ocultoCargaPara.value,
      socio: inputSocio ? inputSocio.value : '',
      cargoDe: ocultoCargo.value,
      silobolsa: document.getElementById('silobolsa').value,
      contratista: contratistasTildados(),
      tractor: elegidosTract(),
      comentarios: document.getElementById('comentarios').value
    };

    var faltan = [];
    if (!datos.patentes.trim()) faltan.push('la patente');
    if (!datos.chofer.trim()) faltan.push('el chofer');
    // La tara solo es obligatoria cuando ya es un peso real de la balanza.
    if (taraEsReal && !Number(datos.tara)) faltan.push('la tara');
    if (datos.cargaPara === 'SOCIO' && !datos.socio.trim()) faltan.push('el socio');
    if (datos.cargoDe === 'SILOBOLSA' && !datos.silobolsa.trim()) faltan.push('el número de silobolsa');
    if (datos.cargoDe === 'CONTRATISTA') {
      if (!datos.contratista.length) faltan.push('el contratista');
      if (!datos.tractor.length) faltan.push('el tractor');
    }
    if (faltan.length) {
      error.innerHTML = 'Falta ' + App.esc(faltan.join(', '));
      return;
    }

    /* El reparto de kg solo existe si el ticket ya tiene la regulada: antes de
       eso no hay neto que repartir. */
    if (datos.cargoDe === 'CONTRATISTA' && bruto) {
      var rt = repartoTractParaGuardar();
      if (rt.error) {
        error.innerHTML = App.esc(rt.error);
        return;
      }
      datos.tractores = rt.lista;
    }

    // Corregir necesita servidor: no se encola. Si no hay señal se dice y listo.
    if (!App.hayConexion()) {
      error.innerHTML = 'Para corregir un ticket hace falta internet.';
      return;
    }

    btn.disabled = true;
    btn.innerHTML = 'Guardando…';
    App.pedir('POST', '/app/api/corregir/<%= r.id %>', datos, function (err, res) {
      if (!err && res && res.ok) {
        window.location.href = res.destino || '<%= volver %>';
        return;
      }
      btn.disabled = false;
      btn.innerHTML = 'Guardar la corrección';
      error.innerHTML = App.esc((err && err.message) || 'No se pudo guardar.');
    });
  });
})();
</script>
