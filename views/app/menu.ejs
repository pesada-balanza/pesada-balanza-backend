<%#
  Botón del rincón. Antes abría una hoja con dos opciones ("Balanza y turno" y
  "Salir de la app"), y eso confundía: el botón decía "Salir" pero no salía, y la
  opción de salir estaba repetida en tres lugares. Ahora hace una sola cosa: sale.

  Cambiar de código es salir y poner el otro, así que con esto también se cambia
  de balanza. Y el nombre de quien está en la balanza se cambia desde el patio,
  tocando el nombre arriba a la izquierda.
%>
<button type="button" class="menu-btn" id="menu-salir">Salir</button>

<script>
(function () {
  'use strict';

  document.getElementById('menu-salir').addEventListener('click', function (ev) {
    ev.preventDefault();

    // Si hay pesadas sin subir, no se sale: se perderían al cambiar de código.
    if (App.cola.cantidad() > 0) {
      window.alert(
        'Hay ' + App.cola.cantidad() + ' pesada(s) todavía guardadas en el teléfono. ' +
        'Conectate a internet y esperá a que se suban antes de salir.'
      );
      return;
    }

    if (!window.confirm(
      '¿Salir de la app?\n\n' +
      'No se borra nada de lo cargado. Después hay que volver a poner el código, ' +
      'y para eso hace falta internet una vez.'
    )) return;

    App.pedir('POST', '/app/api/salir', {}, function () {
      window.location.href = '/app/ingreso';
    });
  });
})();
</script>
