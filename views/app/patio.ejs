<%# Patio — ref. 1a, con los estados de 7a (sin señal), 7c (sin regular) y 5f. %>
<div class="pantalla">

  <div class="enc">
    <div class="enc-col" style="min-width:0">
      <span class="t-pantalla recorta">Patio · <%= datos.balanza %></span>
      <a href="/app/dia?cambio=1" class="txt-aux" style="padding:4px 0">
        <%= datos.nombreDia %> · <span style="color:var(--punteado)">cambiar</span>
      </a>
    </div>
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px">
      <span class="conexion en-linea" data-conexion>EN LÍNEA</span>
      <%- include('menu') %>
    </div>
  </div>

  <div class="cuerpo con-barra">

    <%# El aviso de pesadas guardadas en el teléfono ya no va acá: está en el
        layout, arriba de todas las pantallas y con cualquier código. %>

    <%# Tickets sin imprimir (ref. 5f) %>
    <% if (datos.sinImprimir.length) { %>
      <div class="aviso">
        <div class="aviso-col">
          <span class="aviso-titulo">
            <%= datos.sinImprimir.length %> ticket<%= datos.sinImprimir.length === 1 ? '' : 's' %> sin imprimir
          </span>
          <span class="aviso-detalle mono"><%= datos.sinImprimir.map(function(t){ return t.nro; }).join(' · ') %></span>
        </div>
        <a class="pastilla" href="/app/tickets-pendientes">Imprimir</a>
      </div>
    <% } %>

    <%# Camiones sin regular que quedaron de ayer (ref. 7c) %>
    <% if (datos.sinRegular.length) { %>
      <div class="aviso">
        <div class="aviso-col">
          <span class="aviso-titulo">
            <%= datos.sinRegular.length %> camión<%= datos.sinRegular.length === 1 ? '' : 'es' %> sin regular
          </span>
          <span class="aviso-detalle">quedaron de antes · <span class="mono"><%= datos.sinRegular.map(function(t){ return t.nro; }).join(' · ') %></span></span>
        </div>
        <a class="pastilla" href="#lista">Ver</a>
      </div>
    <% } %>

    <div id="lista" style="display:flex; flex-direction:column; gap:12px">

      <%# Pesadas que todavía están en el teléfono (se dibujan con JS) %>
      <div id="locales" style="display:flex; flex-direction:column; gap:12px"></div>

      <% if (!datos.camiones.length) { %>
        <div class="tarjeta" style="align-items:flex-start; gap:6px">
          <span class="cuerpo-fuerte">No hay camiones en curso</span>
          <span class="txt">Cuando entre el primero, tocá “Nueva pesada”.</span>
        </div>
      <% } %>

      <% datos.camiones.forEach(function (c) { %>
        <div class="tarjeta">
          <div class="fila-base">
            <span class="dato"><%= c.patentes %></span>
            <span class="mono-chico">#<%= c.nro %></span>
          </div>

          <span class="txt">
            <%= [c.transporte, c.chofer, c.campoCorto].filter(Boolean).join(' · ') %>
          </span>

          <div class="chips">
            <% if (c.sinRegularDeAyer) { %>
              <span class="chip chip-ambar">Sin regular de ayer</span>
            <% } %>
            <% if (c.sinImprimir) { %>
              <span class="chip chip-ambar">Ticket sin imprimir</span>
            <% } %>
            <% if (c.paso === 'TARA_FINAL') { %>
              <span class="chip">Falta tara final</span>
            <% } else { %>
              <span class="chip">Falta regulada</span>
            <% } %>
            <% if (c.pedido && c.pedido.tipo === 'ANULACION') { %>
              <span class="chip chip-ambar">Anulación pedida</span>
            <% } else if (c.pedido) { %>
              <span class="chip chip-ambar">Corrección pedida</span>
            <% } %>
          </div>

          <% if (c.fechaTaraFinal && c.sinRegularDeAyer) { %>
            <span class="txt-chico">Tara final <%= c.fechaTaraFinalCorta %><%= c.sinImprimir ? '' : ' · ticket entregado' %></span>
          <% } %>

          <%# Un botón grande con el paso que falta. Sin señal, el mismo botón
              lleva a la pantalla que el teléfono puede dibujar solo. %>
          <% if (c.paso === 'TARA_FINAL') { %>
            <a class="btn" style="min-height:52px" href="/app/tara-final/<%= c.id %>"
               data-con-senal="/app/tara-final/<%= c.id %>"
               data-sin-senal="/app/local?paso=tara-final&id=<%= c.id %>">Cargar tara final</a>
          <% } else { %>
            <a class="btn" style="min-height:52px" href="/app/regulada/<%= c.id %>"
               data-con-senal="/app/regulada/<%= c.id %>"
               data-sin-senal="/app/local?paso=regulada&id=<%= c.id %>">Cargar regulada</a>
          <% } %>

          <%# Sin señal el detalle del servidor no existe, pero la hoja del
              ticket sí se puede dibujar con lo que el teléfono tiene guardado. %>
          <div class="botonera-fila">
            <a class="btn btn-borde-suave" style="min-height:48px; font-size:14px"
               href="/app/registro/<%= c.id %>"
               data-con-senal="/app/registro/<%= c.id %>"
               data-sin-senal="/app/imprimir?locales=<%= c.id %>&volver=/app/patio">Ver ticket</a>
            <% if (!c.pedido) { %>
              <%# Enlace común, no un botón con JavaScript: así el toque navega
                  siempre. La pantalla del pedido avisa si no hay señal. %>
              <a class="btn btn-borde-suave" style="min-height:48px; font-size:14px"
                 href="/app/pedir/<%= c.id %>?tipo=anulacion">Pedir anulación</a>
            <% } %>
          </div>
        </div>
      <% }); %>

    </div>

    <div class="espaciador"></div>
  </div>

  <div class="barra-fija">
    <a class="btn btn-grande" href="/app/nueva-pesada">＋ Nueva pesada</a>
  </div>
</div>

<script>
(function () {
  'use strict';

  // Guardar la foto del patio: es lo que permite seguir un camión que ya está
  // en el servidor cuando después se corta la señal.
  App.guardarPatio(<%- JSON.stringify(datos) %>);

  // Los botones del paso que falta apuntan a un lado o a otro según la señal.
  function acomodarEnlaces() {
    var enLinea = App.hayConexion();
    var enlaces = document.querySelectorAll('[data-sin-senal]');
    for (var e = 0; e < enlaces.length; e++) {
      enlaces[e].href = enLinea
        ? enlaces[e].getAttribute('data-con-senal')
        : enlaces[e].getAttribute('data-sin-senal');
    }
  }
  acomodarEnlaces();
  if (window.addEventListener) {
    window.addEventListener('online', acomodarEnlaces);
    window.addEventListener('offline', acomodarEnlaces);
  }

  // Aviso puntual al volver de otra pantalla
  var aviso = '<%= aviso %>';
  if (aviso === 'pedido-enviado') App.brindis('Pedido enviado a GENERAL.');
  if (aviso === 'anulado') App.brindis('Ticket anulado. El número no se vuelve a usar.');
  if (aviso === 'guardado') App.brindis('Pesada guardada.');

  // Dibujar las pesadas que todavía están en el teléfono, con el chip SIN SUBIR
  // y el paso que falta. Sin señal el ticket se puede cerrar igual: los pasos se
  // encolan apuntando a la pesada y el servidor los enlaza cuando todo sube.
  var contenedor = document.getElementById('locales');
  var pendientes = App.cola.todo();

  // Qué pasos ya se encolaron para cada pesada local
  var pasosPorRef = {};
  for (var k = 0; k < pendientes.length; k++) {
    var q = pendientes[k];
    if (!q.refLocal) continue;
    if (!pasosPorRef[q.refLocal]) pasosPorRef[q.refLocal] = {};
    pasosPorRef[q.refLocal][q.tipo] = q.datos || {};
  }

  var html = '';
  for (var i = 0; i < pendientes.length; i++) {
    var p = pendientes[i];
    if (p.tipo !== 'pesada') continue;
    var d = p.datos || {};
    var pasos = pasosPorRef[p.localId] || {};
    var tieneTF = !!pasos['tara-final'];
    var tieneReg = !!pasos['regulada'];

    var chips = '<span class="chip chip-ambar">Sin subir</span>';
    var accion = '';

    if (tieneReg) {
      chips += '<span class="chip chip-verde">Ticket completo</span>';
      accion = '<span class="txt-chico">Listo. Se sube solo cuando vuelva internet.</span>';
    } else if (tieneTF) {
      chips += '<span class="chip">Falta regulada</span>';
      accion =
        '<a class="btn" style="min-height:52px" href="/app/local?paso=regulada&ref=' +
        encodeURIComponent(p.localId) + '">Cargar regulada</a>' +
        '<a class="btn btn-borde-suave" style="min-height:48px; font-size:14px" ' +
        'href="/app/imprimir?locales=' + encodeURIComponent(p.localId) + '">Imprimir el ticket</a>';
    } else {
      chips += '<span class="chip">Falta tara final</span>';
      accion =
        '<a class="btn" style="min-height:52px" href="/app/local?paso=tara-final&ref=' +
        encodeURIComponent(p.localId) + '">Cargar tara final</a>';
    }

    html += '<div class="tarjeta">' +
      '<div class="fila-base"><span class="dato">' + App.esc(d.patentes || '') + '</span>' +
      '<span class="mono-chico">#' + App.esc(d.nro || '—') + '</span></div>' +
      '<span class="txt">' + App.esc([d.transporte, d.chofer, (d.campo || '').split(' - ')[0]]
        .filter(Boolean).join(' · ')) + '</span>' +
      '<div class="chips">' + chips + '</div>' +
      (tieneTF && !tieneReg
        ? '<span class="txt-chico">Tara final ' +
          App.miles(pasos['tara-final'].taraNueva) + ' kg · guardada en el teléfono</span>'
        : '') +
      accion +
      '</div>';
  }
  contenedor.innerHTML = html;
})();
</script>
