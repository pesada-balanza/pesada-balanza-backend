<%# Detalle del ticket — ref. 7d. Pesos con candado; solo observaciones editables.
     Incluye el modal de anulación con código GENERAL (ref. 6d). %>
<div class="pantalla">

  <div class="enc">
    <div class="enc-col">
      <a href="/app/patio" class="volver"><span class="flecha">‹</span><span class="texto">Patio</span></a>
      <span class="etiqueta">Ticket <%= r.nro %> · <%= r.balanza %></span>
      <span class="t-pantalla mono"><%= r.patentes %></span>
    </div>
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px">
      <span class="conexion en-linea" data-conexion>EN LÍNEA</span>
      <%- include('menu') %>
    </div>
  </div>

  <div class="cuerpo">

    <% if (r.anulado) { %>
      <div class="aviso">
        <div class="aviso-col">
          <span class="aviso-titulo">Ticket anulado</span>
          <span class="aviso-detalle">El número <%= r.nro %> no se vuelve a usar.</span>
        </div>
      </div>
    <% } %>

    <% if (pedido && pedido.estado === 'PENDIENTE') { %>
      <div class="aviso">
        <div class="aviso-col">
          <span class="aviso-titulo"><%= pedido.tipo === 'ANULACION' ? 'Anulación pedida' : 'Corrección pedida' %></span>
          <span class="aviso-detalle">“<%= pedido.motivo %>” · <%= pedido.pedidoPor %> <%= pedido.hora %></span>
        </div>
      </div>
    <% } else if (pedido && pedido.estado === 'RECHAZADO') { %>
      <div class="aviso">
        <div class="aviso-col">
          <span class="aviso-titulo">GENERAL rechazó el pedido</span>
          <span class="aviso-detalle">El ticket sigue vigente. Motivo del pedido: “<%= pedido.motivo %>”</span>
        </div>
      </div>
    <% } else if (pedido && pedido.estado === 'CORREGIDO') { %>
      <%# El que pidió la corrección tiene que enterarse de que se hizo. Sin
          esto veía los datos nuevos y nada que le dijera que cambiaron: si el
          ticket ya estaba impreso y en la mano del chofer, no se daba cuenta. %>
      <div class="aviso">
        <div class="aviso-col">
          <span class="aviso-titulo">GENERAL corrigió el ticket</span>
          <span class="aviso-detalle">
            <% if (pedido.respuesta) { %>Cambió <%= pedido.respuesta %>.<% } %>
            <% if (pedido.cuandoSeResolvio) { %><%= pedido.cuandoSeResolvio %> ·<% } %>
            Se había pedido por: “<%= pedido.motivo %>”
          </span>
        </div>
      </div>
    <% } %>

    <div class="tarjeta">
      <span class="txt"><%= [r.transporte, r.chofer].filter(Boolean).join(' · ') %></span>

      <div class="divisor"></div>
      <div class="fila-col">
        <span class="etiqueta">Campo</span>
        <span class="cuerpo-fuerte" style="font-size:16px"><%= r.campo || '—' %></span>
      </div>

      <% if (r.grano || r.loteTexto) { %>
        <div class="divisor"></div>
        <div class="fila-col">
          <span class="etiqueta">Grano y lote</span>
          <span class="cuerpo-fuerte" style="font-size:16px"><%= [r.grano, r.loteTexto].filter(Boolean).join(' · ') %></span>
        </div>
      <% } %>

      <% if (r.cargoDe) { %>
        <div class="divisor"></div>
        <div class="fila-col">
          <span class="etiqueta">Cargó de</span>
          <span class="txt" style="color:var(--tinta)">
            <%= r.cargoDe === 'SILOBOLSA'
                  ? 'Silobolsa ' + (r.silobolsa || '')
                  : [r.contratista, r.tractor].filter(Boolean).join(' · ') %>
          </span>
        </div>
      <% } %>
    </div>

    <%# Los pesos: fijos una vez guardados %>
    <div class="tarjeta" style="padding:16px; gap:12px">
      <div class="fila">
        <div class="fila-col">
          <span class="etiqueta">Bruto estimado</span>
          <span class="dato-g"><%= kg(r.brutoEstimado) %> kg</span>
        </div>
        <span class="chip-fijo">🔒 fijo</span>
      </div>

      <% if (r.fechaTaraFinal) { %>
        <div class="divisor"></div>
        <div class="fila">
          <div class="fila-col">
            <span class="etiqueta">Tara final</span>
            <span class="dato-g"><%= kg(r.tara) %> kg</span>
          </div>
          <span class="chip-fijo">🔒 fijo</span>
        </div>
      <% } %>

      <% if (r.brutoLote) { %>
        <div class="divisor"></div>
        <div class="fila">
          <div class="fila-col">
            <span class="etiqueta">Bruto lote</span>
            <span class="dato-g"><%= kg(r.brutoLote) %> kg</span>
          </div>
          <span class="chip-fijo">🔒 fijo</span>
        </div>
      <% } %>

      <% if (r.bruto) { %>
        <div class="divisor"></div>
        <div class="fila">
          <div class="fila-col">
            <span class="etiqueta">Bruto regulado</span>
            <span class="dato-g"><%= kg(r.bruto) %> kg</span>
          </div>
          <span class="chip-fijo">🔒 fijo</span>
        </div>
      <% } %>

      <% if (r.neto !== null) { %>
        <div class="divisor" style="background:var(--tinta); height:1.5px"></div>
        <div class="fila">
          <div class="fila-col">
            <span class="etiqueta">Neto</span>
            <span class="dato-xg"><%= kg(r.neto) %> kg</span>
          </div>
        </div>
      <% } %>

      <div class="divisor"></div>
      <div class="fila">
        <div class="fila-col" style="min-width:0">
          <span class="etiqueta">Observaciones</span>
          <span class="cuerpo-fuerte" id="texto-obs" style="font-weight:400; font-size:15px">
            <%= r.comentarios || '—' %>
          </span>
        </div>
        <% if (puedeEditarComentarios) { %>
          <button type="button" class="chip-fijo" data-abre-modal="modal-obs"
                  style="color:var(--tinta); border-color:var(--borde-fuerte); background:transparent; cursor:pointer">Editar</button>
        <% } %>
      </div>
      <%# El CTG viene con la carta de porte, después de la regulada. Si el
          ticket está cerrado y todavía no lo tiene, se ve el renglón vacío con
          el acceso para cargarlo: así no queda escondido. %>
      <% if (r.cp || puedeCargarCtg) { %>
        <div class="divisor"></div>
        <div class="fila">
          <div class="fila-col">
            <span class="etiqueta">CP / CTG</span>
            <span class="dato mono"><%= r.cp || '—' %></span>
          </div>
          <% if (r.cp) { %>
            <span class="chip-fijo">🔒 fijo</span>
          <% } else { %>
            <%# `volver` para que la pantalla del CTG vuelva ACÁ, no al inicio. %>
            <a class="chip-fijo" href="/app/ctg?id=<%= r.id %>&volver=<%= encodeURIComponent('/app/registro/' + r.id) %>"
               style="color:var(--tinta); border-color:var(--borde-fuerte); background:transparent">Cargar</a>
          <% } %>
        </div>
      <% } %>
    </div>

    <%# Acciones %>
    <div class="tarjeta" style="padding:16px; gap:9px">

      <%# Corregir los datos lo puede hacer SOLO GENERAL. El balancero no tiene
          esta opción: pide la corrección y GENERAL la aplica. Va primero cuando
          hay un pedido esperando, que es para lo que GENERAL entró al ticket. %>
      <% if (puedeCorregir) { %>
        <a class="<%= pedido && pedido.estado === 'PENDIENTE' && pedido.tipo === 'CORRECCION' ? 'btn' : 'btn btn-borde' %>"
           href="/app/corregir/<%= r.id %>">Corregir los datos (GENERAL)</a>
      <% } %>

      <a class="btn btn-borde-suave" href="/app/imprimir?ids=<%= r.id %>">Imprimir el ticket</a>

      <% if (puedeCargarCtg) { %>
        <a class="btn btn-borde" href="/app/ctg?id=<%= r.id %>&volver=<%= encodeURIComponent('/app/registro/' + r.id) %>">Cargar el CTG</a>
      <% } %>

      <%# El PDF recién se comparte cuando está cargada la regulada: antes el
          ticket no tiene todos los pesos y solo se imprime (ref. 5e). %>
      <% if (r.completo) { %>
        <button type="button" class="btn btn-borde-suave" id="compartir-pdf"
                data-necesita-internet data-clase-normal="btn btn-borde-suave"
                data-texto="Compartir el PDF">Compartir el PDF</button>
      <% } %>

      <% if (!r.anulado && (!pedido || pedido.estado !== 'PENDIENTE')) { %>
        <%# Enlaces comunes, NO botones con JavaScript.
            Antes eran <button onclick="location.href=…"> y en algunos teléfonos
            el toque no hacía nada: eran los únicos tres lugares de la app que
            dependían de un onclick escrito en el HTML. Ahora son enlaces, igual
            que "Imprimir el ticket", que es lo más simple que hay: el teléfono
            navega solo, sin que tenga que correr nada.
            El caso sin señal lo resuelve la pantalla del pedido, que ya avisa y
            deja el botón de enviar apagado. %>
        <a class="btn btn-borde" href="/app/pedir/<%= r.id %>?tipo=correccion">Pedir corrección a GENERAL</a>
        <a class="btn btn-borde-suave" href="/app/pedir/<%= r.id %>?tipo=anulacion">Pedir anulación a GENERAL</a>

        <%# Anular en el momento SOLO lo ve GENERAL, entrado con su propio código.
            El balancero no tiene esta opción: pide la anulación y GENERAL la
            resuelve. Así el código de GENERAL no circula por las balanzas. %>
        <% if (esGeneral) { %>
          <button type="button" class="btn btn-texto" data-abre-modal="modal-anular">Anular ahora (GENERAL)</button>
        <% } %>
      <% } %>
    </div>

    <div class="espaciador"></div>
    <p class="txt-aux" style="margin:0">Cargado por <%= r.cargadoPor || '—' %></p>
  </div>
</div>

<%# Editar observaciones %>
<% if (puedeEditarComentarios) { %>
<div class="velo" id="modal-obs" hidden>
  <div class="hoja">
    <div class="hoja-texto">
      <span class="etiqueta">Observaciones</span>
      <span class="t-modal">Editar observaciones</span>
      <span class="txt-chico">Quedan <%= 2 - r.modificaciones %> edición<%= (2 - r.modificaciones) === 1 ? '' : 'es' %>.</span>
    </div>
    <div class="campo">
      <textarea id="obs" maxlength="500" rows="4"><%= r.comentarios || '' %></textarea>
    </div>
    <div id="error-obs" class="campo-error" style="min-height:16px"></div>
    <div class="botonera">
      <button type="button" class="btn" id="guardar-obs">Guardar</button>
      <button type="button" class="btn btn-texto" data-cierra-modal="modal-obs">Cancelar</button>
    </div>
  </div>
</div>
<% } %>

<%# Anular en el momento. Solo se dibuja para GENERAL: el balancero no tiene
    esta opción y tampoco este modal, así que su código no aparece en ninguna
    balanza. Ya entró con su código, así que acá no se vuelve a pedir: alcanza
    con confirmar. %>
<% if (esGeneral) { %>
<div class="velo centrado" id="modal-anular" hidden>
  <div class="hoja">
    <div class="hoja-texto">
      <span class="etiqueta-ambar">GENERAL</span>
      <span class="t-modal">Anular el ticket <%= r.nro %></span>
      <span class="txt" style="font-size:14px; line-height:1.5">
        <%= [r.patentes, r.chofer, r.balanza].filter(Boolean).join(' · ') %>.
        Esto no se puede deshacer.
      </span>
    </div>

    <div id="error-anular" class="campo-error" style="min-height:16px"></div>

    <div class="botonera">
      <button type="button" class="btn btn-rojo" id="confirmar-anular">Anular registro</button>
      <button type="button" class="btn btn-texto" data-cierra-modal="modal-anular">Cancelar</button>
    </div>

    <div class="hoja-nota">
      <span class="txt-chico">
        Queda asentado quién anuló y cuándo. El ticket no desaparece: se marca ANULADO
        en los registros y el número <%= r.nro %> no se vuelve a usar.
      </span>
    </div>
  </div>
</div>
<% } %>

<script>
(function () {
  'use strict';
  var idReg = '<%= r.id %>';

  <% if (puedeEditarComentarios) { %>
  var errorObs = document.getElementById('error-obs');
  document.getElementById('guardar-obs').addEventListener('click', function (ev) {
    ev.preventDefault();
    var texto = document.getElementById('obs').value;
    App.enviar({
      url: '/app/api/comentarios/' + idReg,
      datos: { comentarios: texto },
      boton: this,
      alListo: function () {
        document.getElementById('texto-obs').innerHTML = App.esc(texto || '—');
        App.cerrarModal('modal-obs');
        App.brindis('Observaciones guardadas.');
      },
      alFallar: function (msg) { errorObs.innerHTML = App.esc(msg); }
    });
  });
  <% } %>

  <% if (r.completo) { %>
  App.compartir({
    boton: document.getElementById('compartir-pdf'),
    url: '/app/ticket-pdf/' + idReg,
    nombre: <%- JSON.stringify('ticket-' + String(r.nro).replace(/[^\w-]/g, '') + '.pdf') %>,
    titulo: <%- JSON.stringify('Ticket ' + r.nro + ' · ' + r.patentes) %>,
    texto: <%- JSON.stringify(
      'Ticket ' + r.nro + ' · ' + r.patentes +
      (r.chofer ? ' · ' + r.chofer : '') +
      (r.grano ? ' · ' + r.grano : '') +
      (r.neto !== null ? ' · Neto ' + kg(r.neto) + ' kg' : '')
    ) %>
  });
  <% } %>

  <% if (esGeneral) { %>
  var errorAnular = document.getElementById('error-anular');

  document.getElementById('confirmar-anular').addEventListener('click', function (ev) {
    ev.preventDefault();
    if (!App.hayConexion()) {
      errorAnular.innerHTML = 'Anular necesita internet.';
      return;
    }
    App.enviar({
      url: '/app/api/anular',
      datos: { id: idReg },
      boton: this,
      alListo: function (res) { window.location.href = res.destino || '/app/patio'; },
      alFallar: function (msg) { errorAnular.innerHTML = App.esc(msg); }
    });
  });
  <% } %>
})();
</script>
