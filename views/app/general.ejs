<%# Resumen del día — ref. 8a (el elegido). GENERAL no carga nada: mira y autoriza. %>
<div class="pantalla">

  <div class="enc">
    <div class="enc-col">
      <span class="etiqueta"><%= resumen.alcance %></span>
      <%# Arriba siempre la fecha de HOY: es la referencia y no cambia al
          moverse de día. El día que se está mirando lo dice la barra de abajo. %>
      <span class="t-pantalla-g"><%= dias.hoyBonito %></span>
    </div>
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px">
      <span class="conexion en-linea" data-conexion>EN LÍNEA</span>
      <%- include('menu') %>
    </div>
  </div>

  <div class="cuerpo">

    <%# 0. Moverse entre días: el resumen ya no es solo el de hoy %>
    <%- include('nav-dias', { dias: dias }) %>

    <%# 1. Los dos números que importan %>
    <div class="kpis">
      <div class="kpi">
        <span class="etiqueta">Neto del día</span>
        <span class="dato-xg"><%= kg(resumen.netoDia) %></span>
        <span class="txt-aux">kg · <%= resumen.camionesCerrados %> <%= resumen.camionesCerrados === 1 ? 'camión' : 'camiones' %></span>
      </div>
      <div class="kpi">
        <span class="etiqueta">En curso</span>
        <span class="dato-xg"><%= resumen.enCurso %></span>
        <span class="txt-aux">sin cerrar ahora</span>
      </div>
    </div>

    <%# 2. Para revisar — desaparece cuando está limpio %>
    <% if (resumen.revisar.length) { %>
      <div class="bloque-revisar">
        <span class="cuerpo-fuerte">Para revisar · <%= resumen.revisar.length %></span>
        <div style="display:flex; flex-direction:column; gap:8px">
          <% resumen.revisar.forEach(function (x) { %>
            <a class="revisar-fila" href="<%= x.url %>">
              <span class="txt" style="color:var(--tinta)"><%= x.texto %></span>
              <span class="ver">Ver</span>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

    <%# 3. Por balanza — tocable, abre el detalle %>
    <% if (resumen.porBalanza.length) { %>
      <div class="tarjeta" style="gap:13px">
        <span class="cuerpo-fuerte">Por balanza</span>
        <div style="display:flex; flex-direction:column; gap:11px">
          <% resumen.porBalanza.forEach(function (b, i) { %>
            <% if (i > 0) { %><div class="divisor"></div><% } %>
            <a class="fila" href="/app/general/balanza/<%= b.codigo %>?fecha=<%= resumen.fecha %>">
              <div class="fila-col">
                <span class="cuerpo-fuerte"><%= b.nombre %></span>
                <span class="txt-aux">
                  <%= [b.nombreDia, b.camiones + (b.camiones === 1 ? ' camión' : ' camiones')].filter(Boolean).join(' · ') %>
                </span>
              </div>
              <span class="mono" style="font:600 16px/1 var(--mono)"><%= kg(b.neto) %></span>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

    <%# 4. Por grano, con sus lotes indentados %>
    <% if (resumen.porGrano.length) { %>
      <div class="tarjeta" style="gap:13px">
        <div class="fila-base">
          <span class="cuerpo-fuerte">Por grano</span>
          <span class="mono-chico" style="letter-spacing:.06em"><%= dias.esHoy ? 'HOY' : dias.corto %></span>
        </div>

        <% resumen.porGrano.forEach(function (g, i) { %>
          <% if (i > 0) { %><div class="divisor"></div><% } %>
          <div style="display:flex; flex-direction:column; gap:8px">
            <div class="fila-base">
              <span class="cuerpo-fuerte" style="font-size:16px"><%= g.grano %></span>
              <span class="mono" style="font:600 16px/1 var(--mono)"><%= kg(g.neto) %></span>
            </div>
            <div class="lotes">
              <% g.lotes.forEach(function (l) { %>
                <% if (g.unLote) { %>
                  <%# Un solo lote: va como línea gris, sin repetir el kilaje %>
                  <div class="fila-base">
                    <span class="txt-chico"><%= l.lote %> · <%= l.camiones %> <%= l.camiones === 1 ? 'camión' : 'camiones' %></span>
                  </div>
                <% } else { %>
                  <div class="fila-base">
                    <span class="txt" style="font-size:13px">
                      <%= l.lote %> <span style="color:var(--punteado)">· <%= l.camiones %> cam.</span>
                    </span>
                    <span class="mono" style="font:500 13px/1 var(--mono)"><%= kg(l.neto) %></span>
                  </div>
                <% } %>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="tarjeta" style="gap:6px">
        <span class="cuerpo-fuerte">Todavía no hay reguladas cerradas</span>
        <span class="txt">El neto del día aparece cuando los camiones cierran la regulada.</span>
      </div>
    <% } %>

    <%# Buscar va acá, pegado a los números del día: es lo que se hace cuando en
        este día no está el camión que se busca. %>
    <a class="btn btn-borde-suave" href="/app/buscar">Buscar un ticket</a>

    <%# Exportar a Excel: el mismo archivo que el botón de la web, con las mismas
        hojas. Un solo botón, que abre el desde–hasta ya puesto en el día que se
        está mirando: para un día solo hay que tocar "Bajar el Excel". Cada
        código exporta lo que ve: GENERAL todas las balanzas, los demás la suya.

        El archivo lo entrega App.compartir, que lo baja a memoria y lo pasa al
        menú del teléfono. NO es un enlace: en el iPhone, con la app agregada a
        la pantalla de inicio, un enlace a un archivo reemplaza la app por la
        vista previa y no hay forma de volver salvo cerrarla y abrirla. %>
    <button type="button" class="btn btn-borde-suave" id="abrir-excel">Exportar a Excel</button>

    <div class="tarjeta oculto" id="caja-excel" style="gap:11px">
      <span class="etiqueta">Qué días exportar</span>
      <div class="campo">
        <label class="etiqueta" for="ex-desde">Desde</label>
        <input type="date" id="ex-desde" value="<%= resumen.fecha %>" max="<%= hoy %>">
      </div>
      <div class="campo">
        <label class="etiqueta" for="ex-hasta">Hasta</label>
        <input type="date" id="ex-hasta" value="<%= resumen.fecha %>" max="<%= hoy %>">
      </div>
      <button type="button" class="btn" id="bajar-excel">Bajar el Excel</button>
      <button type="button" class="btn btn-texto" id="cerrar-excel">Cancelar</button>
    </div>

    <script>
    (function () {
      'use strict';
      var abrir = document.getElementById('abrir-excel');
      var caja = document.getElementById('caja-excel');
      var cerrar = document.getElementById('cerrar-excel');
      var desde = document.getElementById('ex-desde');
      var hasta = document.getElementById('ex-hasta');

      function rango() {
        var d = desde.value || '<%= resumen.fecha %>';
        var h = hasta.value || d;
        if (d > h) { var t = d; d = h; h = t; }
        return { desde: d, hasta: h };
      }

      var excel = App.compartir({
        boton: document.getElementById('bajar-excel'),
        // Se arma en el momento del toque, con lo que esté elegido.
        url: function () {
          var r = rango();
          return '/app/excel?desde=' + encodeURIComponent(r.desde) + '&hasta=' + encodeURIComponent(r.hasta);
        },
        nombre: function () {
          var r = rango();
          return r.desde === r.hasta
            ? 'registros-' + r.desde + '.xlsx'
            : 'registros-' + r.desde + '-a-' + r.hasta + '.xlsx';
        },
        tipo: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        que: 'el Excel',
        titulo: 'Registros de balanza',
        // El botón dice "Bajar": en la computadora se descarga, como siempre.
        // El menú de compartir se usa solo en el iPhone y el iPad, que es donde
        // descargar no funciona.
        preferirBajar: true,
        // No se baja al abrir la pantalla: el Excel pesa y no todos lo piden.
        // Se empieza a preparar recién cuando se abre la caja, así al tocar
        // "Bajar el Excel" ya está listo y el iPhone lo comparte en el mismo
        // toque, que es lo que exige Safari.
        prepararSolo: false,
      });

      abrir.addEventListener('click', function () {
        caja.className = 'tarjeta';
        abrir.className = 'btn btn-borde-suave oculto';
        excel.preparar();
      });
      cerrar.addEventListener('click', function () {
        caja.className = 'tarjeta oculto';
        abrir.className = 'btn btn-borde-suave';
      });

      // Si cambian las fechas, lo que estaba bajado ya no corresponde.
      function otroRango() {
        excel.olvidar();
        excel.preparar();
      }
      desde.addEventListener('change', otroRango);
      hasta.addEventListener('change', otroRango);
    })();
    </script>

    <%# Este código ve una sola balanza, así que el día que se está mirando se
        puede imprimir de acá mismo. %>
    <%# `porBalanza` es lo del día elegido (los "en curso" no, que son de
        cualquier fecha): si está vacío, ese día no hay nada para imprimir. %>
    <% if (balanzaUnica && resumen.porBalanza.length) { %>
      <a class="btn btn-borde-suave" href="/app/imprimir-dia/<%= balanzaUnica %>?fecha=<%= resumen.fecha %>">
        Imprimir los tickets del día
      </a>
    <% } %>

    <div class="espaciador"></div>

    <div class="botonera">
      <% if (puedeCargar) { %>
        <a class="btn btn-grande" href="/app/patio">＋ Ir al patio a cargar</a>
      <% } else { %>
        <%# Este código solo mira. Para cargar hay que entrar con el de una balanza:
            se lo decimos y le damos el camino en un toque. %>
        <div class="tarjeta" style="gap:9px">
          <span class="cuerpo-fuerte">¿Vas a cargar una pesada?</span>
          <span class="txt">
            Este código entra a mirar y a autorizar. Las pesadas se cargan con el código
            de la balanza, que es el que define de quién es cada ticket.
          </span>
          <button type="button" class="btn" id="ir-a-cargar">Entrar con el código de una balanza</button>
        </div>
      <% } %>

      <%# GENERAL entraba a los pedidos desde "Balanza y turno". Ahora está acá,
          siempre visible: arriba solo aparecen cuando hay alguno pendiente, y
          desde acá se ven también los ya resueltos. %>
      <% if (esGeneral) { %>
        <a class="btn btn-borde-suave" href="/app/general/pedidos">Pedidos de anulación</a>
      <% } %>
    </div>

    <%- include('version') %>
  </div>
</div>

<script>
(function () {
  'use strict';
  var btn = document.getElementById('ir-a-cargar');
  if (!btn) return;
  btn.addEventListener('click', function (ev) {
    ev.preventDefault();
    if (App.cola.cantidad() > 0) {
      window.alert('Hay pesadas sin subir en este teléfono. Esperá a que se suban antes de cambiar de código.');
      return;
    }
    App.pedir('POST', '/app/api/salir', {}, function () {
      window.location.href = '/app/ingreso';
    });
  });
})();
</script>
