<%# Nueva pesada (CAMIONES) — paso 1. Incluye el aviso de camión repetido (7b). %>
<div class="pantalla">

  <div class="enc">
    <div class="enc-col">
      <a href="/app/patio" class="volver"><span class="flecha">‹</span><span class="texto">Patio</span></a>
      <span class="t-pantalla">Nueva pesada</span>
    </div>
    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px">
      <span class="conexion en-linea" data-conexion>EN LÍNEA</span>
      <%- include('menu') %>
    </div>
  </div>

  <div class="cuerpo con-barra">

    <form id="form-pesada" novalidate style="display:flex; flex-direction:column; gap:14px">

      <%# ¿QUÉ DÍA CARGA? — sólo con el código GENERAL de carga.
          Va arriba de todo porque cambia el sentido de todo lo de abajo: no es
          lo mismo cargar un camión que está llegando que dejar preparado el del
          lunes.
          Es una LISTA de 8 días y no un calendario a propósito: así elegir una
          fecha pasada o fuera del tope es imposible, no hay nada que validar ni
          ningún error que mostrar, pesa menos y en el celular se usa con un
          toque. (El servidor valida igual: lo que manda el teléfono no se da
          por bueno nunca.) %>
      <% if (diasCarga) { %>
        <div class="campo">
          <label class="etiqueta" for="fechaCarga">¿Qué día carga?</label>
          <select id="fechaCarga" name="fechaCarga">
            <% diasCarga.forEach(function (d) { %>
              <option value="<%= d.valor %>"><%= d.texto %></option>
            <% }); %>
          </select>
          <span id="aviso-fecha" class="txt-chico"></span>
        </div>
      <% } %>

      <div class="campo">
        <span class="etiqueta">Carga para</span>
        <div class="opciones" data-opciones="cargaPara">
          <button type="button" class="opcion elegida" data-valor="AMH">AMH</button>
          <button type="button" class="opcion" data-valor="SOCIO">Socio</button>
        </div>
        <input type="hidden" name="cargaPara" value="AMH">
      </div>

      <%# El socio sale de una lista (hoja "Socios" de Tablets 25-26.xlsx). Antes
          se tipeaba, y "ProvInvest" / "PROVINVEST" / "Provinvest SA" quedaban
          como socios distintos: cualquier total por socio salía partido. Si la
          lista no se pudo leer se vuelve a escribir a mano, porque no poder
          registrar un camión es peor que un nombre mal escrito. %>
      <div class="campo oculto" id="campo-socio">
        <label class="etiqueta" for="socio">Nombre del socio</label>
        <% if (socios.length) { %>
          <select id="socio" name="socio">
            <option value="">Elegí el socio…</option>
            <% socios.forEach(function (x) { %>
              <option value="<%= x %>"><%= x %></option>
            <% }); %>
          </select>
        <% } else { %>
          <input type="text" id="socio" name="socio" autocapitalize="words" maxlength="60">
        <% } %>
      </div>

      <div class="campo">
        <label class="etiqueta" for="patentes">Patentes</label>
        <input type="text" id="patentes" name="patentes" class="mono" list="lista-patentes"
               autocapitalize="characters" autocomplete="off" maxlength="40"
               placeholder="AC 884 TF">
        <datalist id="lista-patentes"></datalist>
      </div>

      <div class="campo">
        <label class="etiqueta" for="chofer">Chofer</label>
        <input type="text" id="chofer" name="chofer" list="lista-choferes"
               autocapitalize="words" autocomplete="off" maxlength="60">
        <datalist id="lista-choferes"></datalist>
      </div>

      <div class="campo">
        <label class="etiqueta" for="transporte">Transporte</label>
        <input type="text" id="transporte" name="transporte" list="lista-transportes"
               autocapitalize="words" autocomplete="off" maxlength="60">
        <datalist id="lista-transportes"></datalist>
      </div>

      <div class="campo">
        <label class="etiqueta" for="campo">Campo</label>
        <select id="campo" name="campo">
          <option value="">Elegí el campo</option>
          <% campos.forEach(function (c) { %>
            <option value="<%= c %>"><%= c %></option>
          <% }); %>
        </select>
      </div>

      <div class="campo">
        <span class="etiqueta">Bruto estimado</span>
        <div class="opciones" data-opciones="brutoEstimado">
          <% brutosEstimados.forEach(function (b, i) { %>
            <button type="button" class="opcion<%= i === 1 ? ' elegida' : '' %>" data-valor="<%= b %>">
              <span class="mono"><%= b.toLocaleString('es-AR') %></span>
            </button>
          <% }); %>
        </div>
        <input type="hidden" name="brutoEstimado" value="<%= brutosEstimados[1] %>">
      </div>

      <div class="campo">
        <label class="etiqueta" for="tara">Tara (opcional)</label>
        <input type="number" id="tara" name="tara" class="mono" inputmode="numeric"
               min="0" max="<%= taraMax %>" step="10" placeholder="—">
      </div>

      <div id="error-pesada" class="campo-error" style="min-height:18px"></div>
    </form>

    <div class="espaciador"></div>
  </div>

  <div class="barra-fija">
    <button type="button" id="guardar" class="btn btn-grande">Guardar pesada</button>
  </div>
</div>

<%# Modal de camión repetido — ref. 7b %>
<div class="velo centrado" id="modal-repetido" hidden>
  <div class="hoja">
    <div class="hoja-texto">
      <%# Sin "hoy": el día lo dice el renglón de abajo, que ahora puede ser otro. %>
      <span class="etiqueta-ambar">Camión repetido</span>
      <span class="t-modal" id="rep-titulo"></span>
      <span class="txt" style="font-size:14px; line-height:1.5" id="rep-detalle"></span>
    </div>
    <div class="botonera">
      <a class="btn btn-borde-suave" id="rep-ver" href="#">Ver el otro ticket</a>
      <button type="button" class="btn" id="rep-seguir">Es otro viaje, seguir</button>
    </div>
    <span class="txt-chico">El mismo aviso le llega a GENERAL. No bloquea la carga.</span>
  </div>
</div>

<script>
(function () {
  'use strict';

  var form = document.getElementById('form-pesada');
  var error = document.getElementById('error-pesada');
  var btn = document.getElementById('guardar');
  var ocultoCarga = form.elements['cargaPara'];
  var campoSocio = document.getElementById('campo-socio');
  var inputPatentes = document.getElementById('patentes');
  var selCampo = document.getElementById('campo');
  <%# Sólo existen con el código GENERAL de carga: con el de una balanza quedan
      en null y todo lo que sigue cae a "hoy", que es como funcionaba antes. %>
  var selFecha = document.getElementById('fechaCarga');
  var avisoFecha = document.getElementById('aviso-fecha');
  var yaAvisado = '';

  <%# "hoy" o "el lunes": cuándo carga el camión que se está cargando. %>
  function cuandoCarga() {
    if (!selFecha || selFecha.selectedIndex === 0) return 'hoy';
    return 'el ' + selFecha.options[selFecha.selectedIndex].text.split(' ')[0];
  }

  <% if (diasCarga) { %>
  <%# Elegir un día que no es hoy no cambia nada en pantalla, así que sin este
      renglón GENERAL queda con la duda de si el balancero ya lo está viendo.
      Cuando el día ES hoy no dice nada: no hay obviedades que ocupen lugar.
      Va adentro del `if` como el campo: al balancero no le sirve de nada y no
      tiene por qué viajar hasta su teléfono. `cuandoCarga` sí queda afuera,
      porque la usa el cartel de camión repetido, que lo ve todo el mundo. %>
  function revisarFecha() {
    avisoFecha.textContent = selFecha.selectedIndex === 0
      ? ''
      : 'Le aparece al balancero ' + cuandoCarga() + '.';
  }
  selFecha.addEventListener('change', function () { revisarFecha(); revisarRepetido(); });
  revisarFecha();
  <% } %>

  // Autocompletar con lo que ya está cargado en la base.
  App.cargarSugerencias(function (d) {
    App.llenarLista('lista-patentes', d.patentes);
    App.llenarLista('lista-choferes', d.choferes);
    App.llenarLista('lista-transportes', d.transportes);
  });

  // Mostrar/ocultar el nombre del socio
  function revisarSocio() {
    if (ocultoCarga.value === 'SOCIO') campoSocio.className = 'campo';
    else campoSocio.className = 'campo oculto';
  }
  ocultoCarga.addEventListener('cambio-opcion', revisarSocio);
  revisarSocio();

  // Aviso de camión repetido: se consulta al salir de Patentes, y otra vez al
  // elegir el campo, porque con el código 56781 el ticket va a la balanza del
  // campo y de eso depende si el otro ticket es "de otra balanza" o no.
  function revisarRepetido() {
    var p = (inputPatentes.value || '').trim();
    var c = selCampo.value || '';
    <%# El día entra en la clave: cambiar la fecha cambia contra qué se compara,
        así que el aviso se vuelve a pedir en vez de darse por hecho. %>
    var f = selFecha ? selFecha.value : '';
    var clave = p + '|' + c + '|' + f;
    if (!p || clave === yaAvisado || !App.hayConexion()) return;
    yaAvisado = clave;
    App.pedir('GET', '/app/api/repetido?patentes=' + encodeURIComponent(p) +
      '&campo=' + encodeURIComponent(c) +
      (f ? '&fechaCarga=' + encodeURIComponent(f) : ''), null, function (err, res) {
      if (err || !res || !res.repetido) return;
      mostrarRepetido(res.repetido);
    });
  }
  inputPatentes.addEventListener('blur', revisarRepetido);
  selCampo.addEventListener('change', revisarRepetido);

  function mostrarRepetido(r, guardado) {
    document.getElementById('rep-titulo').innerHTML =
      App.esc(r.patentes) + ' ya se cargó ' + cuandoCarga() + ' en ' + App.esc(r.balanza);
    var partes = [];
    if (r.nro) partes.push('ticket ' + r.nro);
    if (r.hora) partes.push('a las ' + r.hora);
    if (r.usuario) partes.push('por ' + r.usuario);
    // Se aclara de quién es el número: el que se muestra es el OTRO ticket.
    // Leerlo como el propio era parte de lo que hacía confuso el aviso.
    var otro = partes.length ? 'El otro es el ' + partes.join(', ') + '. ' : '';
    document.getElementById('rep-detalle').innerHTML =
      (guardado ? 'Tu pesada quedó guardada. ' : '') + App.esc(otro) +
      'Fijate que no sea el mismo viaje cargado dos veces.';
    document.getElementById('rep-ver').href = '/app/registro/' + r.id;
    App.abrirModal('modal-repetido');
  }

  document.getElementById('rep-seguir').addEventListener('click', function (ev) {
    ev.preventDefault();
    App.cerrarModal('modal-repetido');
  });

  function guardar() {
    error.innerHTML = '';
    var datos = App.datosDe(form);

    var faltan = [];
    if (!datos.patentes) faltan.push('la patente');
    if (!datos.chofer) faltan.push('el chofer');
    if (!datos.transporte) faltan.push('el transporte');
    if (!datos.campo) faltan.push('el campo');
    if (datos.cargaPara === 'SOCIO' && !datos.socio) faltan.push('el nombre del socio');
    if (faltan.length) {
      error.innerHTML = 'Falta ' + App.esc(faltan.join(', '));
      return;
    }

    datos.patentes = datos.patentes.toUpperCase();

    // Número reservado: permite cargar e imprimir aunque no haya señal.
    var nro = App.numeros.tomar();
    if (nro) datos.nro = nro;

    App.enviar({
      url: '/app/api/pesada',
      datos: datos,
      offline: true,
      tipo: 'pesada',
      boton: btn,

      alGuardarLocal: function (d) {
        // Sin señal: se confirma en el momento, sin dejar spinner esperando.
        App.guardarTicketLocal({
          localId: d.localId,
          nro: d.nro || '',
          patentes: d.patentes,
          chofer: d.chofer,
          transporte: d.transporte,
          campoCorto: (d.campo || '').split(' - ')[0],
          titular: d.cargaPara === 'SOCIO' ? 'Socio ' + (d.socio || '') : 'AMH',
          brutoEstimado: Number(d.brutoEstimado) || 0,
          tara: Number(d.tara) || 0,
          fechaLarga: '',
          hora: ''
        });
        App.brindis('Pesada guardada en el teléfono. Se sube sola cuando vuelva internet.', 'ambar');
        window.setTimeout(function () { window.location.href = '/app/patio'; }, 900);
      },

      alListo: function (res) {
        if (res.repetido) {
          // Se guardó igual (no bloquea), pero se avisa. El `true` es lo que
          // hace que el cartel arranque diciendo que la pesada ya está.
          mostrarRepetido(res.repetido, true);
          document.getElementById('rep-seguir').innerHTML = 'Listo, volver al patio';
          document.getElementById('rep-seguir').onclick = function (ev) {
            ev.preventDefault();
            window.location.href = '/app/patio';
          };
          return;
        }
        window.location.href = '/app/patio?aviso=guardado';
      },

      alFallar: function (msg) {
        // Si el servidor rechazó, el número reservado vuelve a la reserva.
        if (nro) App.numeros.devolver(nro);
        error.innerHTML = App.esc(msg);
      }
    });
  }

  btn.addEventListener('click', function (ev) { ev.preventDefault(); guardar(); });
  form.addEventListener('submit', function (ev) { ev.preventDefault(); guardar(); });
})();
</script>
